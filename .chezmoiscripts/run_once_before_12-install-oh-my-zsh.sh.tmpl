{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

oh_my_zsh_dir="$HOME/.oh-my-zsh"

if [ -d "$oh_my_zsh_dir" ]; then
    echo "Oh My Zsh ist bereits installiert: $oh_my_zsh_dir"
    exit 0
fi

if ! command -v git >/dev/null 2>&1; then
    echo "git wurde nicht gefunden. Installiere zuerst die Basis-Pakete." >&2
    exit 1
fi

echo "Installiere Oh My Zsh nach $oh_my_zsh_dir ..."
git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$oh_my_zsh_dir"
{{- end }}
